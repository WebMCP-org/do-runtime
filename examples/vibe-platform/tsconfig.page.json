{
  // The DOM-only supervisor uses capnweb directly. The actor worker uses the
  // runtime's session entry because that side sends Workers RpcTarget values.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    // capnweb 0.10's recursive tuple declarations fail under TypeScript 5.9.
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/main.ts", "src/wire.ts", "vite.config.ts"]
}
